{
  "description": "callback write guard: an assistant may not write the fact store or a sealed document",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/write_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
